# Copy to .env and fill in. .env is gitignored and must never be committed.

# Absolute path to your Obsidian vault. Guildhall only ever READS from this folder.
# For local development without a vault, point it at the fixture vault:
#   VAULT_PATH=./tests/fixtures/vault
VAULT_PATH=./tests/fixtures/vault

# Optional: where Guildhall keeps its own data, such as prepared combat encounters (default
# ./data, which is gitignored). Must be outside the vault. Back this folder up if you care about it.
# DATA_PATH=./data

# Optional: your Roll20 campaign URL, shown as a link on the hub home page.
ROLL20_CAMPAIGN_URL=

# Optional: port for the web server (default 3000).
# PORT=3000

# Optional: the address people use to reach Guildhall (default http://localhost:<PORT>). Set it
# when hosting, e.g. https://guildhall.example.com. Just the address, with no path.
# PUBLIC_URL=http://localhost:3000

# Optional: how many reverse proxies sit in front of Guildhall (default 0). Set 1 behind Traefik,
# nginx or Caddy, which end HTTPS; leave it at 0 otherwise, since the forwarded headers it
# trusts could be faked.
# TRUST_PROXY=0

# --- Signing in ---

# Signs session cookies. Required when hosted over HTTPS; without it (locally) everyone is signed
# out whenever the server restarts. At least 32 characters; make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Comma-separate several to rotate: the first signs new cookies, the others still verify.
# SESSION_SECRET=

# Discord user IDs of the DM (comma-separated), who are let straight in with the DM's view.
# In Discord: Settings > Advanced > Developer Mode, then right-click your name > Copy User ID.
# DM_DISCORD_IDS=

# Local development only: one-click sign-in as the DM, a player from the PC notes, or someone
# new, with no Discord. Refused unless PUBLIC_URL is this computer.
DEV_LOGIN=true
