{
  "name": "guildhall",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A personal D&D campaign hub: links to table tools and a read-only wiki over an Obsidian vault.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development node --conditions development --env-file-if-exists=.env server.js",
    "build": "react-router build",
    "start": "cross-env NODE_ENV=production node --env-file-if-exists=.env server.js",
    "typecheck": "react-router typegen && tsc -b",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "srd:import": "node scripts/import-srd.ts",
    "srd:check": "node scripts/import-srd.ts --check",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:e2e",
    "note:check": "node scripts/check-note.ts",
    "srd:note": "node scripts/srd-lookup.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/crimson-pro": "^5.3.0",
    "@fontsource/fondamento": "^5.3.0",
    "@fontsource/grenze-gotisch": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@fontsource/marcellus-sc": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@react-router/express": "^8.4.0",
    "@react-router/node": "^8.4.0",
    "cannon-es": "^0.20.0",
    "chokidar": "^5.0.0",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "hast-util-to-html": "^9.0.5",
    "hastscript": "^9.0.1",
    "isbot": "^5.2.2",
    "mdast-util-find-and-replace": "^3.0.2",
    "minisearch": "^7.2.0",
    "morgan": "^1.12.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.5",
    "three": "^0.187.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
